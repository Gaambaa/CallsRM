# Docker (default — use this when running with docker-compose up)
DATABASE_URL=postgresql+asyncpg://callsrm_user:your_password_here@db/callsrm

# Local development (uncomment and comment the above when running locally)
# DATABASE_URL=postgresql+asyncpg://callsrm_user:your_password_here@localhost/callsrm

POSTGRES_USER=callsrm_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=callsrm
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
N8N_WEBHOOK_URL=your_n8n_webhook_url_here
N8N_SECRET=your_n8n_secret_here
JWT_SECRET=your_jwt_secret_here