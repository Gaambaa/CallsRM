    {
      "name": "Webhooks",
      "item": [
        {
          "name": "POST /webhooks — Incoming Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [{\n    \"id\": \"1440641050914659\",\n    \"changes\": [{\n      \"value\": {\n        \"messaging_product\": \"whatsapp\",\n        \"contacts\": [{\"profile\": {\"name\": \"Test User\"}, \"wa_id\": \"591XXXXXXXXX\"}],\n        \"messages\": [{\n          \"id\": \"wamid.unique-id-here\",\n          \"from\": \"591XXXXXXXXX\",\n          \"timestamp\": \"1782046964\",\n          \"text\": {\"body\": \"Hello from WhatsApp\"},\n          \"type\": \"text\"\n        }]\n      },\n      \"field\": \"messages\"\n    }]\n  }]\n}"
            },
            "url": {
              "raw": "{{base_url}}/webhooks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhooks"
              ]
            },
            "description": "Simulates an incoming WhatsApp message webhook from Meta. Returns 200 OK immediately and processes in background."
          },
          "response": []
        },
        {
          "name": "POST /webhooks — Incoming Call",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [{\n    \"id\": \"1440641050914659\",\n    \"changes\": [{\n      \"value\": {\n        \"messaging_product\": \"whatsapp\",\n        \"calls\": [{\n          \"id\": \"wacid.unique-id-here\",\n          \"from\": \"591XXXXXXXXX\",\n          \"to\": \"591XXXXXXXXX\",\n          \"event\": \"connect\",\n          \"timestamp\": \"1780362791\",\n          \"direction\": \"USER_INITIATED\"\n        }]\n      },\n      \"field\": \"calls\"\n    }]\n  }]\n}"
            },
            "url": {
              "raw": "{{base_url}}/webhooks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhooks"
              ]
            },
            "description": "Simulates an incoming WhatsApp call webhook from Meta. Chatwoot Community Edition ignores this — CallsRM captures and stores it."
          },
          "response": []
        }
      ]
    },
